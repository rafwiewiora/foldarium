# Runtime profile: development, preview, or production.
FOLDARIUM_ENV=development
FOLDARIUM_COMMIT_SHA=
HOST=127.0.0.1
PORT=4319

# Browser-safe Supabase configuration for local development.
FOLDARIUM_DEVELOPMENT_SUPABASE_URL=http://127.0.0.1:54321
FOLDARIUM_DEVELOPMENT_SUPABASE_PUBLISHABLE_KEY=
FOLDARIUM_DEVELOPMENT_STRUCTURE_BASE_URL=http://127.0.0.1:54321/storage/v1/object/public/structures
FOLDARIUM_DEVELOPMENT_WRITES_ENABLED=0

# Server-only values. Never expose these to browser code or commit real values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
REPLAY_PASSWORD=
FOLDARIUM_SELECTOR_BENCHMARK_INGEST_TOKEN=
FOLDARIUM_WEEKLY_RETROSPECTIVE_PARTICIPANT_HMAC_KEY=

# Optional preview-only private evaluation and archive administration.
FOLDARIUM_PREVIEW_PRIVATE_EVALUATION_DESCRIPTOR=
FOLDARIUM_WEEKLY_RETROSPECTIVE_ADMIN_ENABLED=0
FOLDARIUM_WEEKLY_RETROSPECTIVE_ADMIN_ACCESS=

# Pipeline and scoring integrations. All spend-producing actions remain opt-in.
FOLDARIUM_STORAGE_BUCKET=
FOLDARIUM_WEEKLY_REGISTER=0
FOLDARIUM_WEEKLY_SUBMIT=0
CURSOR_API_KEY=

# Optional external preparation datasets.
FOLDARIUM_CAMEO_DIR=
FOLDARIUM_RNP_DATA_DIR=
FOLDARIUM_RNP_ANNOTATIONS=
FOLDARIUM_RNP_WORK_DIR=
FOLDARIUM_QUIZ_DIR=
