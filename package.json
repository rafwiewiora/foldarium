{
  "name": "foldarium",
  "version": "0.1.0",
  "description": "Open-source molecular pose-triage quiz and weekly co-folding pipeline",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/rafwiewiora/foldarium",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "start:env": "node --env-file=.env server.mjs",
    "dev:env": "node --env-file=.env --watch server.mjs",
    "test": "node --test && npm run audit:public",
    "audit:public": "node scripts/audit-public-tree.mjs",
    "parity:production": "node scripts/check-production-parity.mjs",
    "data:legacy": "node scripts/fetch-legacy-data.mjs",
    "upload:structures": "node scripts/upload-structures.mjs",
    "upload:benchmark": "node scripts/upload-structures.mjs --benchmark"
  }
}
